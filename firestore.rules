rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net - default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return true;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidReel(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.title is string && data.title.size() <= 300 &&
             data.videoUrl is string && data.videoUrl.size() <= 1000 &&
             data.thumbnailUrl is string && data.thumbnailUrl.size() <= 1000 &&
             data.likes is int && data.likes >= 0 &&
             data.plays is string && data.plays.size() <= 100 &&
             data.duration is string && data.duration.size() <= 30 &&
             data.tag is string && data.tag.size() <= 100;
    }

    function isValidLead(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() <= 200 &&
             data.phone is string && data.phone.size() <= 100 &&
             data.date is string && data.date.size() <= 50 &&
             data.guests is string && data.guests.size() <= 50 &&
             data.comment is string && data.comment.size() <= 3000 &&
             (!data.keys().contains('packageName') || data.packageName is string) &&
             (!data.keys().contains('packagePrice') || data.packagePrice is int || data.packagePrice is float || data.packagePrice is number) &&
             data.createdAt is string && data.createdAt.size() <= 100 &&
             data.status is string && data.status in ['new', 'processing', 'completed', 'canceled'];
    }

    // 1. Sections Collection Rules
    match /sections/{sectionId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(sectionId);
    }

    // 2. Services Collection Rules
    match /services/{serviceId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(serviceId);
    }

    // 3. Reviews Collection Rules
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isValidId(reviewId) &&
                       incoming().author is string && incoming().author.size() <= 100 &&
                       incoming().text is string && incoming().text.size() <= 1500 &&
                       incoming().rating is int && incoming().rating >= 1 && incoming().rating <= 5 &&
                       incoming().source is string && incoming().source in ['yandex', 'google', 'vk', 'manual'] &&
                       incoming().date is string && incoming().date.size() <= 30;
      allow update, delete: if isAdmin() && isValidId(reviewId);
    }

    // 4. Contacts Config Rules
    match /config/contacts {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 5. Reels Collection Rules
    match /reels/{reelId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(reelId) && isValidReel(incoming());
    }

    // 6. Leads Collection Rules
    match /leads/{leadId} {
      allow read: if isAdmin();
      allow create: if isValidId(leadId) && isValidLead(incoming());
      allow update, delete: if isAdmin() && isValidId(leadId);
    }
  }
}
